# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "polito:cve2:cve2_vector:0.1"
description: "Modules for RISC-V subset of vector extension support for CVE2 CPU"

filesets:
  files_rtl:
    depend:
      - openhwgroup:cve2:cve2_pkg
    files:
      - rtl/cve2_fracturable_adder.sv
      - rtl/cve2_multdiv_fast_fracturable.sv
      - rtl/cve2_cs_registers_vec.sv
      - rtl/cve2_vrf_interface.sv
      - rtl/cve2_vrf_interface_double.sv
      - rtl/cve2_agu.sv
      - rtl/cve2_agu_double.sv
      - rtl/cve2_lsu_interface.sv
      - rtl/cve2_dmem_switch.sv
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_rtl
  
  lint:
    <<: *default_target 
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          # RAM primitives wider than 64bit (required for ECC) fail to build in
          # Verilator without increasing the unroll count (see Verilator#1266)
          - "--unroll-count 72"

format:
  <<: *default_target
  default_tool: veribleformat
  tools:
    veribleformat:
      verible_format_args:
        - "--inplace"

