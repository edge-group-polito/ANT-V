`verilator_config

// VRF interface
lint_off -rule UNUSED -file "*/rtl/cve2_vrf_interface*.sv" -match "Signal is not used: 'data_err_i'"
lint_off -rule UNUSED -file "*/rtl/cve2_vrf_interface*.sv" -match "Signal is not used: 'data_pmp_err_i'"
lint_off -rule UNUSED -file "*/rtl/cve2_vrf_interface*.sv" -match "Signal is not used: 'unit_stride_i'"
lint_off -rule UNUSED -file "*/rtl/cve2_vrf_interface*.sv" -match "Signal is not used: 'lmul_i'"
lint_off -rule UNUSED -file "*/rtl/cve2_vrf_interface*.sv" -match "Parameter is not used: 'NUM_BYTE_OPS'"

// AGU
lint_off -rule UNUSED -file "*/rtl/cve2_cs_registers_vec.sv" -match "Bits of signal are not used: 'alu_operand_b_ex_i'[31:8]"
lint_off -rule WIDTH -file "*/rtl/cve2_cs_registers_vec.sv" -match "Operator * expects 32 bits on the LHS, but LHS's SIGNED generates 3 bits."
lint_off -rule UNUSED -file "*/rtl/cve2_agu*.sv" -match "Bits of signal are not used: 'addr_i'[*]"

lint_off -rule UNUSED -file "*/rtl/cve2_multdiv_fast_fracturable.sv" -match "Bits of signal are not used: 'mac_res_d_sca'[33:32]"
lint_off -rule UNUSED -file "*/rtl/cve2_alu.sv" -match "Bits of signal are not used: 'vsew_i'[2]"

lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not driven, nor used: 'vrf_raddr*'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not driven, nor used: 'vrf_waddr*'"

lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'vrf_we_id'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'is_slide_up'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'vrf_*'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'agu_*'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'vx_instr'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'vl_keep'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'lsu_if_load_addr'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'is_slide_up'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'unit_stride'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'vl_q'"
lint_off -rule UNUSED -file "*/rtl/cve2_core.sv" -match "Signal is not used: 'vmem_ops_eew'"

lint_off -rule UNUSED -file "*/rtl/cve2_id_stage.sv" -match "Signal is not used: 'vector_done_i'"
lint_off -rule UNUSED -file "*/rtl/cve2_id_stage.sv" -match "Signal is not used: 'illegal_vec_csr_insn_i'"
lint_off -rule UNUSED -file "*/rtl/cve2_id_stage.sv" -match "Signal is not used: 'vrf_*_i'"
lint_off -rule UNUSED -file "*/rtl/cve2_id_stage.sv" -match "Signal is not used: 'vslide_op_a'"
lint_off -rule UNUSED -file "*/rtl/cve2_id_stage.sv" -match "Signal is not used: 'vcfg_write'"

lint_off -rule UNUSED -file "*/rtl/cve2_ex_block.sv" -match "Signal is not used: 'alu_operand_c_i'"
lint_off -rule UNUSED -file "*/rtl/cve2_ex_block.sv" -match "Signal is not used: 'multdiv_operand_b'"
lint_off -rule UNUSED -file "*/rtl/cve2_ex_block.sv" -match "Signal is not used: 'multdiv_result_q'"
lint_off -rule UNUSED -file "*/rtl/cve2_ex_block.sv" -match "Signal is not used: 'use_mult_add'"

lint_off -rule UNUSED -file "*/rtl/cve2_alu.sv" -match "Signal is not used: 'adder_ew'"

lint_off -rule UNUSED -file "*/rtl/cve2_wb.sv" -match "Signal is not used: 'vrf*_i'"
lint_off -rule UNUSED -file "*/rtl/cve2_wb.sv" -match "Signal is not used: 'vl*_i'"


